# =====================================================================
# APURVA AI TEACHER — ENVIRONMENT CONFIGURATION
# =====================================================================

# Database Configuration (PostgreSQL / SQLite)
# Defaults to local persistent SQLite at data/ai_teacher.db if left empty
DATABASE_URL=sqlite:///data/ai_teacher.db

# Optional Redis / Background Worker URL
REDIS_URL=

# Realtime Video / Audio Gateway (Agora)
AGORA_APP_ID=
AGORA_TEMP_TOKEN=
AGORA_TOKEN_TTL_SECONDS=3600

# Optional Neural LLM / Inference Providers
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional Neural TTS Provider (OpenAI TTS / ElevenLabs)
# If left empty, automatically falls back to local procedural WAV audio
TTS_PROVIDER=openai
TTS_API_KEY=

# Optional Neural Video Avatar Provider (HeyGen / D-ID / SadTalker)
# If left empty, automatically falls back to procedural animated SVG presenter
AVATAR_PROVIDER=heygen
AVATAR_API_KEY=
AVATAR_ENDPOINT=https://api.heygen.com/v2/video/generate

# Observability (Optional Langfuse Tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Server Environment
ENVIRONMENT=development
DEBUG=true
PORT=5000
