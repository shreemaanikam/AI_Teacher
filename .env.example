# =================================================================
# APURVA AI TEACHER — ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================================
# All external cloud services feature deterministic, zero-crash local
# fallbacks allowing testing/evaluation even with partial credentials.

# -----------------------------------------------------------------
# 1. PRIMARY AI & REASONING (Google Gemini - REQUIRED for live LLM)
# -----------------------------------------------------------------
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2

# -----------------------------------------------------------------
# 2. PERSISTENCE & CACHE (Neon PostgreSQL & Upstash Redis)
# -----------------------------------------------------------------
# Neon Serverless PostgreSQL connection string (defaults to local SQLite if unset)
DATABASE_URL=

# Upstash Serverless Redis REST endpoint & token for session locks (defaults to in-memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------
# 3. VECTOR DATABASE (Pinecone RAG Index)
# -----------------------------------------------------------------
# Pinecone Serverless Index (Dimension: 1024, Metric: cosine)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=ai-teacher
PINECONE_HOST=
VECTOR_DB_PROVIDER=pinecone

# -----------------------------------------------------------------
# 4. NEURAL SPEECH SYNTHESIS (ElevenLabs TTS)
# -----------------------------------------------------------------
# Multilingual v2 neural voice (falls back to OpenAI TTS -> Local TTS)
ELEVENLABS_API_KEY=
TTS_PROVIDER=elevenlabs

# -----------------------------------------------------------------
# 5. SECONDARY & OPTIONAL FALLBACK PROVIDERS
# -----------------------------------------------------------------
# OpenAI (Secondary LLM fallback & optional Whisper STT)
OPENAI_API_KEY=
STT_PROVIDER=openai

# Google Cloud Vision OCR (defaults to Local OCR if GCP billing unavailable)
GOOGLE_CLOUD_VISION_API_KEY=
OCR_PROVIDER=google_vision

# D-ID Video / Avatar Generation (credit guarded; defaults to Procedural Presenter)
DID_API_KEY=
VIDEO_PROVIDER=did

# Weaviate Vector Database (Alternative to Pinecone)
WEAVIATE_URL=
WEAVIATE_API_KEY=

# Agora RTC Audio Streaming
AGORA_APP_ID=
AGORA_TEMP_TOKEN=
AGORA_TOKEN_TTL_SECONDS=3600

# -----------------------------------------------------------------
# 6. SERVER & RUNTIME SETTINGS
# -----------------------------------------------------------------
PORT=5000
HOST=127.0.0.1
APP_ENV=development
DEBUG=false
